{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-engine.local/contracts/m08/composition.v1.schema.json",
  "title": "NEX M08 2.5D composition contract v1",
  "description": "Versioned 2.5D composition observation. Representation only: does not implement or admit M08.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "captured_at_utc", "base_3d_plan", "layer_stack", "depth_policy", "alpha_policy", "overlay_safety", "critical_entities", "performance", "provenance"],
  "properties": {
    "schema_version": {"const": "composition.v1"},
    "observation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "captured_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "base_3d_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_schema", "opaque_count", "alpha_count", "overlay_count", "z_fight_risks", "alpha_over_critical", "overlay_gameplay_conflicts"],
      "properties": {
        "plan_schema": {"enum": ["depth_composition.plan.v1", "none"]},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "opaque_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "alpha_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "overlay_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "z_fight_risks": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "alpha_over_critical": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "overlay_gameplay_conflicts": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    },
    "layer_stack": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer_id", "role", "parallax", "blend_mode", "alpha", "gameplay_critical", "may_cover_gameplay"],
        "properties": {
          "layer_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
          "role": {"enum": ["background", "gameplay", "foreground", "hud"]},
          "parallax": {"type": "number", "minimum": 0, "maximum": 4},
          "blend_mode": {"enum": ["normal", "add", "multiply", "screen"]},
          "alpha": {"type": "number", "minimum": 0, "maximum": 1},
          "gameplay_critical": {"type": "boolean"},
          "may_cover_gameplay": {"type": "boolean"},
          "depth_override_m": {"type": "number", "minimum": -1000, "maximum": 1000}
        }
      }
    },
    "depth_policy": {"enum": ["inherit_3d", "override_per_layer", "hybrid"]},
    "alpha_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sort", "critical_guard", "max_alpha_over_gameplay"],
      "properties": {
        "sort": {"const": "back_to_front"},
        "critical_guard": {"type": "boolean"},
        "max_alpha_over_gameplay": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "overlay_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hud_layer_id", "may_cover_gameplay", "conflict_policy"],
      "properties": {
        "hud_layer_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
        "may_cover_gameplay": {"type": "boolean"},
        "conflict_policy": {"enum": ["report", "block"]}
      }
    },
    "critical_entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "role", "must_remain_visible"],
        "properties": {
          "entity_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
          "role": {"enum": ["player", "threat", "objective"]},
          "must_remain_visible": {"type": "boolean"}
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_status", "frame_interval", "gpu_render_time", "cpu_render_time", "draw_calls", "renderer_allocation_bytes"],
      "properties": {
        "measurement_status": {"enum": ["MEASURED", "UNAVAILABLE"]},
        "frame_interval": {"$ref": "#/$defs/frame_interval"},
        "gpu_render_time": {"$ref": "#/$defs/optional_number"},
        "cpu_render_time": {"$ref": "#/$defs/optional_number"},
        "draw_calls": {"$ref": "#/$defs/optional_integer"},
        "renderer_allocation_bytes": {"$ref": "#/$defs/optional_integer"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "godot_version", "hardware", "capture_mode", "measurement_status"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "godot_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gpu_model", "driver_version"],
          "properties": {
            "gpu_model": {"type": "string", "minLength": 1, "maxLength": 120},
            "driver_version": {"type": "string", "minLength": 1, "maxLength": 60},
            "device_memory_mib": {"type": "integer", "minimum": 0, "maximum": 1048576}
          }
        },
        "capture_mode": {"enum": ["windowed", "fullscreen", "headless"]},
        "measurement_status": {"enum": ["MEASURED", "UNAVAILABLE"]},
        "evidence_uri": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  },
  "$defs": {
    "frame_interval": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "provider", "samples_ms"],
          "properties": {
            "status": {"const": "MEASURED"},
            "provider": {"const": "SceneTree._process(delta)"},
            "samples_ms": {"type": "array", "minItems": 1, "maxItems": 16000, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "provider", "unavailable_reason"],
          "properties": {
            "status": {"const": "UNAVAILABLE"},
            "provider": {"const": "SceneTree._process(delta)"},
            "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}
          }
        }
      ]
    },
    "optional_number": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {"status": {"const": "MEASURED"}, "value": {"type": "number", "minimum": 0, "maximum": 60000}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "unavailable_reason"],
          "properties": {"status": {"const": "UNAVAILABLE"}, "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}}
        }
      ]
    },
    "optional_integer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {"status": {"const": "MEASURED"}, "value": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "unavailable_reason"],
          "properties": {"status": {"const": "UNAVAILABLE"}, "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}}
        }
      ]
    }
  }
}
