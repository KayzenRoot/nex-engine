{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-engine.local/contracts/m11/asset_pipeline.v1.schema.json",
  "title": "NEX M11 asset pipeline contract v1",
  "description": "Versioned asset-pipeline observation. Representation only: does not implement or admit M11.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "captured_at_utc", "assets", "policy", "budget", "performance", "provenance"],
  "properties": {
    "schema_version": {"const": "asset_pipeline.v1"},
    "observation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "captured_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "kind", "source_uri", "source_sha256", "cooked_bytes", "stages", "license"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
          "kind": {"enum": ["texture", "model", "audio", "font", "animation", "vfx"]},
          "source_uri": {"type": "string", "minLength": 1, "maxLength": 512},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "cooked_bytes": {"type": "integer", "minimum": 0, "maximum": 17179869184},
          "stages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage", "status"],
              "properties": {
                "stage": {"enum": ["raw", "imported", "cooked", "validated"]},
                "status": {"enum": ["pending", "pass", "fail", "skipped"]},
                "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "tool_id": {"type": "string", "minLength": 1, "maxLength": 120}
              }
            }
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["spdx_id", "source_uri", "attribution", "verification"],
            "properties": {
              "spdx_id": {"type": "string", "minLength": 1, "maxLength": 64},
              "source_uri": {"type": "string", "minLength": 1, "maxLength": 512},
              "attribution": {"type": "string", "minLength": 0, "maxLength": 512},
              "verification": {"enum": ["verified", "unverified", "rejected"]},
              "evidence_uri": {"type": "string", "minLength": 1, "maxLength": 512}
            }
          },
          "import_settings": {
            "type": "object",
            "additionalProperties": false,
            "required": ["compression"],
            "properties": {
              "compression": {"enum": ["none", "lossless", "lossy"]},
              "max_dimension_px": {"type": "integer", "minimum": 1, "maximum": 16384},
              "lod_count": {"type": "integer", "minimum": 1, "maximum": 8},
              "audio_bitrate_kbps": {"type": "integer", "minimum": 8, "maximum": 512}
            }
          },
          "dependencies": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"}
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_spdx_ids", "require_attribution", "require_verified_license", "allow_unverified", "require_cooked_artifact"],
      "properties": {
        "allowed_spdx_ids": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "require_attribution": {"type": "boolean"},
        "require_verified_license": {"type": "boolean"},
        "allow_unverified": {"type": "boolean"},
        "require_cooked_artifact": {"type": "boolean"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_assets", "max_total_bytes", "max_texture_bytes", "max_unverified_licenses"],
      "properties": {
        "max_assets": {"type": "integer", "minimum": 0, "maximum": 10000},
        "max_total_bytes": {"type": "integer", "minimum": 0, "maximum": 17179869184},
        "max_texture_bytes": {"type": "integer", "minimum": 0, "maximum": 17179869184},
        "max_unverified_licenses": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_status", "frame_interval", "gpu_render_time", "cpu_render_time", "draw_calls", "renderer_allocation_bytes"],
      "properties": {
        "measurement_status": {"enum": ["MEASURED", "UNAVAILABLE"]},
        "frame_interval": {"$ref": "#/$defs/frame_interval"},
        "gpu_render_time": {"$ref": "#/$defs/optional_number"},
        "cpu_render_time": {"$ref": "#/$defs/optional_number"},
        "draw_calls": {"$ref": "#/$defs/optional_integer"},
        "renderer_allocation_bytes": {"$ref": "#/$defs/optional_integer"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "godot_version", "hardware", "capture_mode", "measurement_status"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "godot_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gpu_model", "driver_version"],
          "properties": {
            "gpu_model": {"type": "string", "minLength": 1, "maxLength": 120},
            "driver_version": {"type": "string", "minLength": 1, "maxLength": 60},
            "device_memory_mib": {"type": "integer", "minimum": 0, "maximum": 1048576}
          }
        },
        "capture_mode": {"enum": ["windowed", "fullscreen", "headless"]},
        "measurement_status": {"enum": ["MEASURED", "UNAVAILABLE"]},
        "evidence_uri": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  },
  "$defs": {
    "frame_interval": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "provider", "samples_ms"],
          "properties": {
            "status": {"const": "MEASURED"},
            "provider": {"const": "SceneTree._process(delta)"},
            "samples_ms": {"type": "array", "minItems": 1, "maxItems": 16000, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "provider", "unavailable_reason"],
          "properties": {
            "status": {"const": "UNAVAILABLE"},
            "provider": {"const": "SceneTree._process(delta)"},
            "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}
          }
        }
      ]
    },
    "optional_number": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {"status": {"const": "MEASURED"}, "value": {"type": "number", "minimum": 0, "maximum": 60000}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "unavailable_reason"],
          "properties": {"status": {"const": "UNAVAILABLE"}, "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}}
        }
      ]
    },
    "optional_integer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {"status": {"const": "MEASURED"}, "value": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "unavailable_reason"],
          "properties": {"status": {"const": "UNAVAILABLE"}, "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}}
        }
      ]
    }
  }
}
