{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-engine.local/contracts/m04/material.v1.schema.json",
  "title": "NEX M04 material contract v1",
  "description": "Versioned PBR material observation. Representation only: does not implement or admit M04.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "captured_at_utc", "materials", "texture_budget", "performance", "provenance"],
  "properties": {
    "schema_version": {"const": "material.v1"},
    "observation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "captured_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "materials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["material_id", "shader_id", "surface", "alpha_mode", "cull_mode", "quality_variant", "textures"],
        "properties": {
          "material_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
          "shader_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "surface": {
            "type": "object",
            "additionalProperties": false,
            "required": ["albedo_rgba", "metallic", "roughness", "emission_rgba", "emission_energy", "normal_strength", "occlusion_strength"],
            "properties": {
              "albedo_rgba": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
              "metallic": {"type": "number", "minimum": 0, "maximum": 1},
              "roughness": {"type": "number", "minimum": 0, "maximum": 1},
              "emission_rgba": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
              "emission_energy": {"type": "number", "minimum": 0, "maximum": 16},
              "normal_strength": {"type": "number", "minimum": 0, "maximum": 2},
              "occlusion_strength": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "alpha_mode": {"enum": ["opaque", "mask", "blend"]},
          "alpha_cutoff": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "cull_mode": {"enum": ["back", "front", "disabled"]},
          "quality_variant": {"enum": ["high", "medium", "low"]},
          "decal_surface": {"type": "boolean"},
          "textures": {
            "type": "array",
            "minItems": 0,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slot", "uri", "sha256", "width_px", "height_px", "mipmaps", "srgb"],
              "properties": {
                "slot": {"enum": ["albedo", "normal", "orm", "emission", "detail"]},
                "uri": {"type": "string", "minLength": 1, "maxLength": 512},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "width_px": {"type": "integer", "minimum": 1, "maximum": 16384},
                "height_px": {"type": "integer", "minimum": 1, "maximum": 16384},
                "mipmaps": {"type": "boolean"},
                "srgb": {"type": "boolean"}
              }
            }
          }
        }
      }
    },
    "texture_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_texture_count", "max_texture_bytes", "atlas_size", "orm_packed"],
      "properties": {
        "max_texture_count": {"type": "integer", "minimum": 0, "maximum": 1024},
        "max_texture_bytes": {"type": "integer", "minimum": 0, "maximum": 17179869184},
        "atlas_size": {"type": "integer", "minimum": 256, "maximum": 8192},
        "orm_packed": {"type": "boolean"}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_status", "frame_interval", "gpu_render_time", "cpu_render_time", "draw_calls", "renderer_allocation_bytes"],
      "properties": {
        "measurement_status": {"enum": ["MEASURED", "UNAVAILABLE"]},
        "frame_interval": {"$ref": "#/$defs/frame_interval"},
        "gpu_render_time": {"$ref": "#/$defs/optional_number"},
        "cpu_render_time": {"$ref": "#/$defs/optional_number"},
        "draw_calls": {"$ref": "#/$defs/optional_integer"},
        "renderer_allocation_bytes": {"$ref": "#/$defs/optional_integer"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "godot_version", "hardware", "capture_mode", "measurement_status"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "godot_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gpu_model", "driver_version"],
          "properties": {
            "gpu_model": {"type": "string", "minLength": 1, "maxLength": 120},
            "driver_version": {"type": "string", "minLength": 1, "maxLength": 60},
            "device_memory_mib": {"type": "integer", "minimum": 0, "maximum": 1048576}
          }
        },
        "capture_mode": {"enum": ["windowed", "fullscreen", "headless"]},
        "measurement_status": {"enum": ["MEASURED", "UNAVAILABLE"]},
        "evidence_uri": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  },
  "$defs": {
    "frame_interval": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "provider", "samples_ms"],
          "properties": {
            "status": {"const": "MEASURED"},
            "provider": {"const": "SceneTree._process(delta)"},
            "samples_ms": {"type": "array", "minItems": 1, "maxItems": 16000, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "provider", "unavailable_reason"],
          "properties": {
            "status": {"const": "UNAVAILABLE"},
            "provider": {"const": "SceneTree._process(delta)"},
            "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}
          }
        }
      ]
    },
    "optional_number": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {"status": {"const": "MEASURED"}, "value": {"type": "number", "minimum": 0, "maximum": 60000}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "unavailable_reason"],
          "properties": {"status": {"const": "UNAVAILABLE"}, "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}}
        }
      ]
    },
    "optional_integer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {"status": {"const": "MEASURED"}, "value": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "unavailable_reason"],
          "properties": {"status": {"const": "UNAVAILABLE"}, "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}}
        }
      ]
    }
  }
}
