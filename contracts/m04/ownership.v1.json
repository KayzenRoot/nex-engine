{
  "schema_version": "m04_ownership.v1",
  "status": "CONTRACT_ONLY_PROSPECTIVE_OWNERSHIP_NOT_MODULE_ADMISSION",
  "writer": "integration-steward",
  "paths": [
    {
      "path": "contracts/m04/**",
      "owner": "integration-steward",
      "mode": "contract",
      "consumers": ["m04-shaderforge", "m04-surfaceblend", "m04-texturebudget"]
    },
    {
      "path": "nex_modules/materials/shaderforge/**",
      "owner": "m04-shaderforge",
      "mode": "future-write",
      "consumers": ["m04-surfaceblend", "m04-texturebudget"]
    },
    {
      "path": "nex_modules/materials/surfaceblend/**",
      "owner": "m04-surfaceblend",
      "mode": "future-write",
      "consumers": ["m04-texturebudget"]
    },
    {
      "path": "nex_modules/materials/texturebudget/**",
      "owner": "m04-texturebudget",
      "mode": "future-write",
      "consumers": []
    },
    {
      "path": "tests/materials/**",
      "owner": "test-authors",
      "mode": "future-write",
      "consumers": []
    }
  ],
  "shared_read_only": [
    "nex_bench/project.godot",
    "nex_bench/hub.gd",
    "contracts/m01/**",
    "contracts/m02/**",
    "contracts/m03/**",
    "contracts/m04/**"
  ],
  "rules": {
    "single_writer_per_path": true,
    "no_ancestor_descendant_overlap": true,
    "no_absolute_or_traversal_paths": true,
    "shared_files_require_steward": true,
    "contract_consumers_are_read_only": true,
    "module_admission_implied": false
  }
}
