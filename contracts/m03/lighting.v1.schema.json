{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-engine.local/contracts/m03/lighting.v1.schema.json",
  "title": "NEX M03 lighting contract v1",
  "description": "Versioned lighting observation. Representation only: does not implement or admit M03.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "captured_at_utc", "environment", "lights", "shadow_budget", "performance", "provenance"],
  "properties": {
    "schema_version": {"const": "lighting.v1"},
    "observation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "captured_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ambient_source", "ambient_color_rgba", "ambient_energy", "tonemap", "glow", "fog", "gi"],
      "properties": {
        "ambient_source": {"enum": ["color", "sky", "disabled"]},
        "ambient_color_rgba": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "ambient_energy": {"type": "number", "minimum": 0, "maximum": 8},
        "tonemap": {"enum": ["linear", "reinhard", "filmic", "aces"]},
        "glow": {"type": "boolean"},
        "fog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "density", "light_energy"],
          "properties": {
            "enabled": {"type": "boolean"},
            "density": {"type": "number", "minimum": 0, "maximum": 1},
            "light_energy": {"type": "number", "minimum": 0, "maximum": 8}
          }
        },
        "gi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "energy"],
          "properties": {
            "mode": {"enum": ["disabled", "sdfgi", "voxelgi", "lightmapgi"]},
            "energy": {"type": "number", "minimum": 0, "maximum": 4}
          }
        }
      }
    },
    "lights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["light_id", "light_type", "color_rgba", "energy", "shadow_enabled", "shadow_bias", "shadow_softness", "cull_mask"],
        "properties": {
          "light_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
          "light_type": {"enum": ["directional", "omni", "spot"]},
          "color_rgba": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
          "energy": {"type": "number", "minimum": 0, "maximum": 16},
          "shadow_enabled": {"type": "boolean"},
          "shadow_bias": {"type": "number", "minimum": 0, "maximum": 1},
          "shadow_softness": {"type": "number", "minimum": 0, "maximum": 1},
          "range_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 200},
          "spot_angle_degrees": {"type": "number", "exclusiveMinimum": 0, "maximum": 90},
          "cascades": {"type": "integer", "minimum": 1, "maximum": 4},
          "cull_mask": {"type": "integer", "minimum": 1, "maximum": 1048575}
        }
      }
    },
    "shadow_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_shadowed_lights", "directional_cascades", "atlas_size"],
      "properties": {
        "max_shadowed_lights": {"type": "integer", "minimum": 0, "maximum": 16},
        "directional_cascades": {"type": "integer", "minimum": 1, "maximum": 4},
        "atlas_size": {"type": "integer", "minimum": 256, "maximum": 8192}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_status", "frame_interval", "gpu_render_time", "cpu_render_time", "draw_calls", "renderer_allocation_bytes"],
      "properties": {
        "measurement_status": {"enum": ["MEASURED", "UNAVAILABLE"]},
        "frame_interval": {"$ref": "#/$defs/frame_interval"},
        "gpu_render_time": {"$ref": "#/$defs/optional_number"},
        "cpu_render_time": {"$ref": "#/$defs/optional_number"},
        "draw_calls": {"$ref": "#/$defs/optional_integer"},
        "renderer_allocation_bytes": {"$ref": "#/$defs/optional_integer"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "godot_version", "hardware", "capture_mode", "measurement_status"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "godot_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gpu_model", "driver_version"],
          "properties": {
            "gpu_model": {"type": "string", "minLength": 1, "maxLength": 120},
            "driver_version": {"type": "string", "minLength": 1, "maxLength": 60},
            "device_memory_mib": {"type": "integer", "minimum": 0, "maximum": 1048576}
          }
        },
        "capture_mode": {"enum": ["windowed", "fullscreen", "headless"]},
        "measurement_status": {"enum": ["MEASURED", "UNAVAILABLE"]},
        "evidence_uri": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  },
  "$defs": {
    "frame_interval": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "provider", "samples_ms"],
          "properties": {
            "status": {"const": "MEASURED"},
            "provider": {"const": "SceneTree._process(delta)"},
            "samples_ms": {"type": "array", "minItems": 1, "maxItems": 16000, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "provider", "unavailable_reason"],
          "properties": {
            "status": {"const": "UNAVAILABLE"},
            "provider": {"const": "SceneTree._process(delta)"},
            "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}
          }
        }
      ]
    },
    "optional_number": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {"status": {"const": "MEASURED"}, "value": {"type": "number", "minimum": 0, "maximum": 60000}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "unavailable_reason"],
          "properties": {"status": {"const": "UNAVAILABLE"}, "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}}
        }
      ]
    },
    "optional_integer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {"status": {"const": "MEASURED"}, "value": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "unavailable_reason"],
          "properties": {"status": {"const": "UNAVAILABLE"}, "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}}
        }
      ]
    }
  }
}
