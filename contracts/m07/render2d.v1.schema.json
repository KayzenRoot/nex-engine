{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-engine.local/contracts/m07/render2d.v1.schema.json",
  "title": "NEX M07 advanced 2D pipeline contract v1",
  "description": "Versioned interface for 2D canvas observations. Representation only: this schema does not implement or admit M07, and it defines no FPS claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_id",
    "captured_at_utc",
    "viewport",
    "render_settings",
    "canvas",
    "performance",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "render2d.v1"},
    "frame_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "captured_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px", "unit"],
      "properties": {
        "width_px": {"type": "integer", "minimum": 1, "maximum": 16384},
        "height_px": {"type": "integer", "minimum": 1, "maximum": 16384},
        "unit": {"const": "px"}
      }
    },
    "render_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer_id", "driver_id", "vsync_mode", "max_fps"],
      "properties": {
        "renderer_id": {"const": "godot.forward_plus"},
        "driver_id": {"enum": ["vulkan", "d3d12"]},
        "vsync_mode": {"enum": [0, 1, 2]},
        "max_fps": {"type": "integer", "minimum": 0, "maximum": 240},
        "pixel_snap": {"type": "boolean"},
        "default_filter": {"enum": ["nearest", "linear"]}
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layers", "materials", "lights", "particles", "batching"],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["layer_id", "z_index", "blend_mode", "material_id", "transform", "visible"],
            "properties": {
              "layer_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
              "z_index": {"type": "integer", "minimum": -4096, "maximum": 4096},
              "blend_mode": {"enum": ["mix", "add", "sub", "mul", "premul_alpha"]},
              "material_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
              "transform": {
                "type": "object",
                "additionalProperties": false,
                "required": ["position_px", "scale", "rotation_deg"],
                "properties": {
                  "position_px": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "number"}
                  },
                  "scale": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "number", "minimum": 0.001, "maximum": 1000}
                  },
                  "rotation_deg": {"type": "number", "minimum": -360, "maximum": 360}
                }
              },
              "visible": {"type": "boolean"}
            }
          }
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["material_id", "shader_id", "lighting_mode"],
            "properties": {
              "material_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
              "shader_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
              "lighting_mode": {"enum": ["unshaded", "canvas_light"]}
            }
          }
        },
        "lights": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["light_id", "light_type", "color_rgba", "energy", "texture_scale"],
            "properties": {
              "light_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
              "light_type": {"enum": ["point", "directional"]},
              "color_rgba": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "energy": {"type": "number", "minimum": 0, "maximum": 100},
              "texture_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}
            }
          }
        },
        "particles": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["emitter_id", "amount", "lifetime_s", "emitting"],
            "properties": {
              "emitter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
              "amount": {"type": "integer", "minimum": 0, "maximum": 100000},
              "lifetime_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 600},
              "emitting": {"type": "boolean"}
            }
          }
        },
        "batching": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_draw_calls", "batch_groups", "state_changes"],
          "properties": {
            "max_draw_calls": {"type": "integer", "minimum": 0, "maximum": 100000},
            "batch_groups": {"type": "integer", "minimum": 0, "maximum": 100000},
            "state_changes": {"type": "integer", "minimum": 0, "maximum": 100000}
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_status",
        "frame_interval",
        "gpu_render_time",
        "cpu_render_time",
        "draw_calls",
        "objects_rendered",
        "renderer_allocation_bytes"
      ],
      "properties": {
        "measurement_status": {"enum": ["MEASURED", "UNAVAILABLE"]},
        "frame_interval": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "provider", "samples_ms"],
              "properties": {
                "status": {"const": "MEASURED"},
                "provider": {"const": "SceneTree._process(delta)"},
                "samples_ms": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16000,
                  "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "provider", "unavailable_reason"],
              "properties": {
                "status": {"const": "UNAVAILABLE"},
                "provider": {"const": "SceneTree._process(delta)"},
                "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}
              }
            }
          ]
        },
        "gpu_render_time": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "value"],
              "properties": {
                "status": {"const": "MEASURED"},
                "value": {"type": "number", "minimum": 0, "maximum": 60000}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "unavailable_reason"],
              "properties": {
                "status": {"const": "UNAVAILABLE"},
                "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}
              }
            }
          ]
        },
        "cpu_render_time": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "value"],
              "properties": {
                "status": {"const": "MEASURED"},
                "value": {"type": "number", "minimum": 0, "maximum": 60000}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "unavailable_reason"],
              "properties": {
                "status": {"const": "UNAVAILABLE"},
                "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}
              }
            }
          ]
        },
        "draw_calls": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "value"],
              "properties": {
                "status": {"const": "MEASURED"},
                "value": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "unavailable_reason"],
              "properties": {
                "status": {"const": "UNAVAILABLE"},
                "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}
              }
            }
          ]
        },
        "objects_rendered": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "value"],
              "properties": {
                "status": {"const": "MEASURED"},
                "value": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "unavailable_reason"],
              "properties": {
                "status": {"const": "UNAVAILABLE"},
                "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}
              }
            }
          ]
        },
        "renderer_allocation_bytes": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "value"],
              "properties": {
                "status": {"const": "MEASURED"},
                "value": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "unavailable_reason"],
              "properties": {
                "status": {"const": "UNAVAILABLE"},
                "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}
              }
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "godot_version", "hardware", "capture_mode", "measurement_status"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "godot_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gpu_model", "driver_version"],
          "properties": {
            "gpu_model": {"type": "string", "minLength": 1, "maxLength": 120},
            "driver_version": {"type": "string", "minLength": 1, "maxLength": 60},
            "device_memory_mib": {"type": "integer", "minimum": 0, "maximum": 1048576}
          }
        },
        "capture_mode": {"enum": ["windowed", "fullscreen", "headless"]},
        "measurement_status": {"enum": ["MEASURED", "UNAVAILABLE"]},
        "evidence_uri": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
