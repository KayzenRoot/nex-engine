{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-engine.local/contracts/m06/performance.v1.schema.json",
  "title": "NEX M06 performance contract v1",
  "description": "Versioned performance observation. Representation only: does not implement or admit M06.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "captured_at_utc", "workload", "frame_interval", "timings", "resources", "bottleneck", "provenance"],
  "properties": {
    "schema_version": {"const": "performance.v1"},
    "observation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "captured_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "proxy_count", "effect_mode", "resolution", "vsync", "max_fps"],
      "properties": {
        "scene_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
        "proxy_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "effect_mode": {"enum": ["geometry", "lights", "vfx", "combined", "none"]},
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width_px", "height_px", "unit"],
          "properties": {
            "width_px": {"type": "integer", "minimum": 1, "maximum": 16384},
            "height_px": {"type": "integer", "minimum": 1, "maximum": 16384},
            "unit": {"const": "px"}
          }
        },
        "vsync": {"type": "boolean"},
        "max_fps": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "frame_interval": {"$ref": "#/$defs/frame_interval"},
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_render_ms", "cpu_render_ms", "frame_pacing_ms"],
      "properties": {
        "gpu_render_ms": {"$ref": "#/$defs/optional_number"},
        "cpu_render_ms": {"$ref": "#/$defs/optional_number"},
        "frame_pacing_ms": {"$ref": "#/$defs/optional_number"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draw_calls", "objects_rendered", "renderer_allocation_bytes", "vram_used_bytes"],
      "properties": {
        "draw_calls": {"$ref": "#/$defs/optional_integer"},
        "objects_rendered": {"$ref": "#/$defs/optional_integer"},
        "renderer_allocation_bytes": {"$ref": "#/$defs/optional_integer"},
        "vram_used_bytes": {"$ref": "#/$defs/optional_integer"}
      }
    },
    "bottleneck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "evidence", "confidence", "rationale"],
      "properties": {
        "classification": {"enum": ["gpu", "cpu", "pacing", "memory", "unknown", "insufficient_data"]},
        "evidence": {"enum": ["measured", "derived", "unavailable"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_observation_id", "delta_gpu_ms", "delta_cpu_ms"],
      "properties": {
        "baseline_observation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
        "delta_gpu_ms": {"type": "number", "minimum": -10000, "maximum": 10000},
        "delta_cpu_ms": {"type": "number", "minimum": -10000, "maximum": 10000}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "godot_version", "hardware", "capture_mode", "measurement_status"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "godot_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gpu_model", "driver_version"],
          "properties": {
            "gpu_model": {"type": "string", "minLength": 1, "maxLength": 120},
            "driver_version": {"type": "string", "minLength": 1, "maxLength": 60},
            "device_memory_mib": {"type": "integer", "minimum": 0, "maximum": 1048576}
          }
        },
        "capture_mode": {"enum": ["windowed", "fullscreen", "headless"]},
        "measurement_status": {"enum": ["MEASURED", "UNAVAILABLE"]},
        "evidence_uri": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  },
  "$defs": {
    "frame_interval": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "provider", "samples_ms"],
          "properties": {
            "status": {"const": "MEASURED"},
            "provider": {"const": "SceneTree._process(delta)"},
            "samples_ms": {"type": "array", "minItems": 1, "maxItems": 16000, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "provider", "unavailable_reason"],
          "properties": {
            "status": {"const": "UNAVAILABLE"},
            "provider": {"const": "SceneTree._process(delta)"},
            "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}
          }
        }
      ]
    },
    "optional_number": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {"status": {"const": "MEASURED"}, "value": {"type": "number", "minimum": 0, "maximum": 60000}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "unavailable_reason"],
          "properties": {"status": {"const": "UNAVAILABLE"}, "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}}
        }
      ]
    },
    "optional_integer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {"status": {"const": "MEASURED"}, "value": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "unavailable_reason"],
          "properties": {"status": {"const": "UNAVAILABLE"}, "unavailable_reason": {"type": "string", "minLength": 1, "maxLength": 240}}
        }
      ]
    }
  }
}
