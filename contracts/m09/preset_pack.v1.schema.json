{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-engine.local/contracts/m09/preset_pack.v1.schema.json",
  "title": "NEX M09 preset pack contract v1",
  "description": "Versioned editor/quality preset pack. Representation only: does not implement or admit M09.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "captured_at_utc", "pack_id", "presets", "compatibility", "provenance"],
  "properties": {
    "schema_version": {"const": "preset_pack.v1"},
    "observation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "captured_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "pack_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preset_id", "label", "tier", "settings"],
        "properties": {
          "preset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 120},
          "tier": {"enum": ["low", "medium", "high", "ultra", "custom"]},
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "rendering": {
                "type": "object",
                "additionalProperties": false,
                "required": ["renderer_id", "driver_id", "resolution_scale", "msaa", "shadow_quality"],
                "properties": {
                  "renderer_id": {"type": "string", "minLength": 1, "maxLength": 80},
                  "driver_id": {"enum": ["vulkan", "d3d12", "opengl3"]},
                  "resolution_scale": {"type": "number", "minimum": 0.25, "maximum": 2.0},
                  "msaa": {"enum": ["off", "2x", "4x", "8x"]},
                  "shadow_quality": {"enum": ["off", "low", "medium", "high", "ultra"]}
                }
              },
              "lighting": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tonemap", "glow", "shadow_atlas_size", "max_shadowed_lights"],
                "properties": {
                  "tonemap": {"enum": ["linear", "reinhard", "filmic", "aces"]},
                  "glow": {"type": "boolean"},
                  "shadow_atlas_size": {"type": "integer", "minimum": 256, "maximum": 8192},
                  "max_shadowed_lights": {"type": "integer", "minimum": 0, "maximum": 16}
                }
              },
              "performance": {
                "type": "object",
                "additionalProperties": false,
                "required": ["target_fps", "max_draw_calls", "lod_bias"],
                "properties": {
                  "target_fps": {"type": "integer", "minimum": 30, "maximum": 240},
                  "max_draw_calls": {"type": "integer", "minimum": 0, "maximum": 10000},
                  "lod_bias": {"type": "number", "minimum": 0, "maximum": 4}
                }
              },
              "composition": {
                "type": "object",
                "additionalProperties": false,
                "required": ["depth_policy", "parallax_scale"],
                "properties": {
                  "depth_policy": {"enum": ["inherit_3d", "override_per_layer", "hybrid"]},
                  "parallax_scale": {"type": "number", "minimum": 0, "maximum": 2}
                }
              },
              "feedback": {
                "type": "object",
                "additionalProperties": false,
                "required": ["hit_stop_scale", "shake_scale", "reduced_motion"],
                "properties": {
                  "hit_stop_scale": {"type": "number", "minimum": 0, "maximum": 2},
                  "shake_scale": {"type": "number", "minimum": 0, "maximum": 2},
                  "reduced_motion": {"type": "boolean"}
                }
              },
              "accessibility": {
                "type": "object",
                "additionalProperties": false,
                "required": ["min_text_contrast_ratio", "focus_ring_px"],
                "properties": {
                  "min_text_contrast_ratio": {"type": "number", "minimum": 3, "maximum": 21},
                  "focus_ring_px": {"type": "integer", "minimum": 1, "maximum": 16}
                }
              }
            }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_versions", "godot_version_range", "hardware_tier"],
      "properties": {
        "contract_versions": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "pattern": "^[a-z0-9_]+\\.v[0-9]+$"}},
        "godot_version_range": {"type": "string", "minLength": 1, "maxLength": 80},
        "hardware_tier": {"enum": ["integrated", "desktop", "enthusiast"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "godot_version", "hardware", "capture_mode", "measurement_status"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "godot_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gpu_model", "driver_version"],
          "properties": {
            "gpu_model": {"type": "string", "minLength": 1, "maxLength": 120},
            "driver_version": {"type": "string", "minLength": 1, "maxLength": 60},
            "device_memory_mib": {"type": "integer", "minimum": 0, "maximum": 1048576}
          }
        },
        "capture_mode": {"enum": ["windowed", "fullscreen", "headless"]},
        "measurement_status": {"enum": ["MEASURED", "UNAVAILABLE"]},
        "evidence_uri": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
