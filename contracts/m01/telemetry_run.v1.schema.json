{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KayzenRoot/nex-engine/blob/main/contracts/m01/telemetry_run.v1.schema.json",
  "title": "NEX telemetry run v1",
  "description": "A measured or synthetic run with explicit provenance, units and unavailable hardware values. This contract makes no FPS or GPU performance claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "git_sha",
    "scene_id",
    "scene_sha256",
    "renderer_id",
    "toolchain",
    "execution_mode",
    "clock",
    "frame_time_unit",
    "warmup_count",
    "sample_count",
    "samples",
    "gpu",
    "vram"
  ],
  "properties": {
    "schema_version": {
      "const": "telemetry_run.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Lowercase 40-hex Git commit object ID (SHA-1), distinct from asset SHA-256."
    },
    "scene_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "scene_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Must equal the referenced scene manifest digest."
    },
    "renderer_id": {
      "type": "string",
      "enum": [
        "godot.forward_plus",
        "godot.mobile",
        "godot.compatibility"
      ]
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_version",
        "toolchain_id",
        "platform"
      ],
      "properties": {
        "engine_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "toolchain_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "synthetic",
        "headless",
        "editor"
      ]
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "timestamp_unit"
      ],
      "properties": {
        "domain": {
          "const": "monotonic"
        },
        "timestamp_unit": {
          "const": "ms"
        }
      }
    },
    "frame_time_unit": {
      "const": "ms"
    },
    "warmup_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "description": "Must equal the length of samples; consumers enforce this cross-field invariant."
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestamp_ms",
          "frame_time_ms"
        ],
        "properties": {
          "timestamp_ms": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000000000,
            "description": "Timestamp from the monotonic clock, in milliseconds."
          },
          "frame_time_ms": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 60000,
            "description": "Frame duration in milliseconds."
          }
        }
      },
      "description": "Timestamps must strictly increase; frame-time samples must be finite and positive."
    },
    "gpu": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "source",
            "utilization_percent"
          ],
          "properties": {
            "availability": {
              "const": "AVAILABLE"
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "utilization_percent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "A measured zero is valid and distinct from UNAVAILABLE."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "source"
          ],
          "properties": {
            "availability": {
              "const": "UNAVAILABLE"
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "State why GPU utilization is unavailable."
            }
          }
        }
      ]
    },
    "vram": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "source",
            "used_bytes"
          ],
          "properties": {
            "availability": {
              "const": "AVAILABLE"
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "used_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Measured VRAM use in bytes; zero remains a numeric measurement."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "source"
          ],
          "properties": {
            "availability": {
              "const": "UNAVAILABLE"
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "State why VRAM use is unavailable."
            }
          }
        }
      ]
    }
  }
}
