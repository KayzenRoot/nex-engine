{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nex-engine.local/contracts/m12/identity.v1.schema.json",
  "title": "NEX M12 visual identity contract v1",
  "description": "Versioned visual-identity observation. Representation only: does not implement or admit M12.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_id", "captured_at_utc", "palette", "typography", "logo", "spacing", "accessibility", "provenance"],
  "properties": {
    "schema_version": {"const": "identity.v1"},
    "observation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "captured_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"},
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token", "hex", "role"],
        "properties": {
          "token": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
          "hex": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
          "role": {"enum": ["primary", "secondary", "accent", "background", "surface", "foreground", "error", "success", "warning"]},
          "description": {"type": "string", "minLength": 0, "maxLength": 240}
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["font_family", "display_size_px", "body_size_px", "line_height_ratio", "weights"],
      "properties": {
        "font_family": {"type": "string", "minLength": 1, "maxLength": 120},
        "display_size_px": {"type": "integer", "minimum": 24, "maximum": 200},
        "body_size_px": {"type": "integer", "minimum": 10, "maximum": 48},
        "line_height_ratio": {"type": "number", "minimum": 1.0, "maximum": 2.5},
        "weights": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "integer", "minimum": 100, "maximum": 900}}
      }
    },
    "logo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mark_svg_uri", "mark_sha256", "mark_view_box", "wordmark_svg_uri", "wordmark_sha256", "wordmark_view_box", "monochrome_sha256", "clear_space_ratio"],
      "properties": {
        "mark_svg_uri": {"type": "string", "minLength": 1, "maxLength": 512},
        "mark_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mark_view_box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "wordmark_svg_uri": {"type": "string", "minLength": 1, "maxLength": 512},
        "wordmark_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "wordmark_view_box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        "monochrome_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "clear_space_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_px", "scale", "max_content_width_px"],
      "properties": {
        "base_px": {"type": "integer", "minimum": 2, "maximum": 32},
        "scale": {"type": "array", "minItems": 3, "maxItems": 12, "items": {"type": "number", "minimum": 1, "maximum": 512}},
        "max_content_width_px": {"type": "integer", "minimum": 320, "maximum": 7680}
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_text_contrast_ratio", "min_large_text_contrast_ratio", "requires_focus_indicator", "min_focus_ring_px"],
      "properties": {
        "min_text_contrast_ratio": {"type": "number", "minimum": 3, "maximum": 21},
        "min_large_text_contrast_ratio": {"type": "number", "minimum": 3, "maximum": 21},
        "requires_focus_indicator": {"type": "boolean"},
        "min_focus_ring_px": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_sha", "head_sha", "godot_version", "hardware", "capture_mode", "measurement_status"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "godot_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gpu_model", "driver_version"],
          "properties": {
            "gpu_model": {"type": "string", "minLength": 1, "maxLength": 120},
            "driver_version": {"type": "string", "minLength": 1, "maxLength": 60},
            "device_memory_mib": {"type": "integer", "minimum": 0, "maximum": 1048576}
          }
        },
        "capture_mode": {"enum": ["windowed", "fullscreen", "headless"]},
        "measurement_status": {"enum": ["MEASURED", "UNAVAILABLE"]},
        "evidence_uri": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
